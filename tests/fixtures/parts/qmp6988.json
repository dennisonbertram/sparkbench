 "example": {
  "code": "from machine import I2C, Pin\nimport time\ni2c = I2C({I2C_ID}, sda=Pin({SDA}), scl=Pin({SCL}))\nA = 0x70\nprint('ID', hex(i2c.readfrom_mem(A, 0xD1, 1)[0]))\nc = i2c.readfrom_mem(A, 0xA0, 25)\ndef s16(i):\n    v = c[i] << 8 | c[i + 1]\n    return v - 65536 if v > 32767 else v\ndef s20(v):\n    return v - 1048576 if v > 524287 else v\ndef K(a, s, i):\n    return a + s * s16(i) / 32767\nb00 = s20(c[0] << 12 | c[1] << 4 | c[24] >> 4) / 16\na0 = s20(c[18] << 12 | c[19] << 4 | (c[24] & 15)) / 16\nbt1 = K(1.0e-1, 9.1e-2, 2); bt2 = K(1.2e-8, 1.2e-6, 4); bp1 = K(3.3e-2, 1.9e-2, 6); b11 = K(2.1e-7, 1.4e-7, 8)\nbp2 = K(-6.3e-10, 3.5e-10, 10); b12 = K(2.9e-13, 7.6e-13, 12); b21 = K(2.1e-15, 1.2e-14, 14); bp3 = K(1.3e-16, 7.9e-17, 16)\na1 = K(-6.3e-3, 4.3e-4, 20); a2 = K(-1.9e-11, 1.2e-10, 22)\ni2c.writeto_mem(A, 0xF4, b'\\x27')\nwhile True:\n    d = i2c.readfrom_mem(A, 0xF7, 6)\n    Dp = (d[0] << 16 | d[1] << 8 | d[2]) - 8388608\n    Dt = (d[3] << 16 | d[4] << 8 | d[5]) - 8388608\n    Tr = a0 + a1 * Dt + a2 * Dt * Dt\n    Pr = b00 + bt1 * Tr + bp1 * Dp + b11 * Tr * Dp + bt2 * Tr * Tr + bp2 * Dp * Dp + b12 * Dp * Tr * Tr + b21 * Dp * Dp * Tr + bp3 * Dp * Dp * Dp\n    print('P=%.1f T=%.1f' % (Pr / 100, Tr / 256))\n    time.sleep_ms(500)\n",
