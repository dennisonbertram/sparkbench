  "code": "from machine import UART, Pin\nimport time\nu = UART({UART_ID}, baudrate=9600, tx=Pin({RX}), rx=Pin({TX}))\nwhile True:\n    u.write(bytes([0x11, 0x01, 0x01, 0xED]))\n    time.sleep_ms(100)\n    r = u.read(8)\n    if r and len(r) == 8 and r[0] == 0x16 and (256 - sum(r[:7]) % 256) % 256 == r[7]:\n        print('CO2=%d' % (r[3] * 256 + r[4]))\n    time.sleep(1)\n",
