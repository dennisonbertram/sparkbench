  "code": "from machine import UART, Pin\nimport time\nu = UART({UART_ID}, baudrate=9600, tx=Pin({RX}), rx=Pin({TX}))\ntime.sleep(1)\nprint('quiet' if u.any() == 0 else 'noisy')\nwhile True:\n    if u.any() >= 14:\n        r = u.read(14)\n        if r[0] == 2 and r[13] == 3:\n            x = 0\n            for i in range(1, 11, 2):\n                x ^= int(r[i:i+2], 16)\n            if x == int(r[11:13], 16):\n                print('TAG=' + r[1:11].decode())\n    time.sleep_ms(20)\n",
