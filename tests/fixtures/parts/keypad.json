{"type": "custom-keypad-test", "name": "Keypad test", "mpn": "4x4 keypad", "category": "input", "description": "t", "eli5": "t", "refPrefix": "SW", "interface": "passive", "pins": [{"name": "R1", "role": "io", "fn": "digital-out", "required": true}, {"name": "R2", "role": "io", "fn": "digital-out", "required": true}, {"name": "R3", "role": "io", "fn": "digital-out", "required": true}, {"name": "R4", "role": "io", "fn": "digital-out", "required": true}, {"name": "C1", "role": "io", "fn": "digital-in", "required": true}, {"name": "C2", "role": "io", "fn": "digital-in", "required": true}, {"name": "C3", "role": "io", "fn": "digital-in", "required": true}, {"name": "C4", "role": "io", "fn": "digital-in", "required": true}], "priceUsd": 2, "supplierQuery": "4x4 membrane keypad", "sim": {"kind": "keypad-matrix", "rowPins": ["R1", "R2", "R3", "R4"], "colPins": ["C1", "C2", "C3", "C4"], "keys": [["1", "2", "3", "A"], ["4", "5", "6", "B"], ["7", "8", "9", "C"], ["*", "0", "#", "D"]]}, "example": {"code": "from machine import Pin\nimport time\nROWS = [Pin(g, Pin.OUT, value=1) for g in ({R1}, {R2}, {R3}, {R4})]\nCOLS = [Pin(g, Pin.IN, Pin.PULL_UP) for g in ({C1}, {C2}, {C3}, {C4})]\nKEYS = ['123A', '456B', '789C', '*0#D']\nlast = None\nwhile True:\n    key = None\n    for r, row in enumerate(ROWS):\n        row.value(0)\n        for c, col in enumerate(COLS):\n            if col.value() == 0:\n                key = KEYS[r][c]\n        row.value(1)\n    if key and key != last:\n        print('KEY=' + key)\n    last = key\n    time.sleep_ms(20)\n", "test": {"id": "t", "title": "keys", "source": "user", "steps": [{"kind": "set", "part": "{REF}", "control": "value", "value": 6}, {"kind": "expect", "what": "serial", "text": "KEY=5", "within": 3000}, {"kind": "set", "part": "{REF}", "control": "value", "value": 0}, {"kind": "wait", "ms": 200}, {"kind": "set", "part": "{REF}", "control": "value", "value": 16}, {"kind": "expect", "what": "serial", "text": "KEY=D", "within": 3000}]}}}