 "example": {
  "code": "from machine import I2C, Pin\nimport time\ni2c = I2C({I2C_ID}, sda=Pin({SDA}), scl=Pin({SCL}))\n\n\ndef crc7(val):\n    pol = 0x89 << 16\n    bit = 1 << 23\n    val = (val << 7) | 0x7F\n    while bit & (0x1FFFF << 7):\n        if bit & val:\n            val ^= pol\n        bit >>= 1\n        pol >>= 1\n    return val\n\n\nwhile True:\n    b = i2c.readfrom_mem(0x43, 0x30, 6)\n    t = b[0] | b[1] << 8 | b[2] << 16\n    h = b[3] | b[4] << 8 | b[5] << 16\n    ok = all((v >> 16) & 1 and crc7(v & 0x1FFFF) == (v >> 17) for v in (t, h))\n    if ok:\n        print('T=%.1f H=%.1f' % ((t & 0xFFFF) / 64 - 273.15, (h & 0xFFFF) / 512))\n    else:\n        print('CRC error')\n    time.sleep(1)\n",
  "test": {
   "id": "t",
   "title": "reads",
   "source": "user",
   "steps": [
