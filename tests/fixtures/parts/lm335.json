  }
 },
 "example": {
  "code": "from machine import ADC, Pin\nimport time\nadc = ADC(Pin({V_}))\ntry:\n    adc.atten(ADC.ATTN_11DB)\nexcept AttributeError:\n    pass\nwhile True:\n    v = adc.read_u16() * 3.3 / 65535\n    print('T=%d' % round(v * 100 - 273.15))\n    time.sleep_ms(300)\n",
  "test": {
   "id": "t",
   "title": "temp",
   "source": "user",
   "steps": [
    {
     "kind": "set",
     "part": "{REF}",
     "control": "value",
     "value": 25
    },
    {
     "kind": "expect",
     "what": "serial",
     "text": "T=25",
     "within": 3000
    }
   ]
  }
 }
