  "code": "from machine import I2C, Pin, ADC\nimport time\ni2c = I2C({I2C_ID}, sda=Pin({SDA}), scl=Pin({SCL}))\nadc = ADC(Pin({VOUT}))\ndef volts():\n    time.sleep_ms(20)\n    return adc.read_u16() * 3.3 / 65535\ni2c.writeto(0x62, bytes([1241 >> 8, 1241 & 0xFF]))\nprint('fast %.2f' % volts())\ncode = 2482\ni2c.writeto(0x62, bytes([0x40, code >> 4, (code & 15) << 4]))\nprint('reg %.2f' % volts())\ns = i2c.readfrom(0x62, 5)\nprint('readback %d' % (s[1] << 4 | s[2] >> 4))\ni2c.writeto(0x62, bytes([0x10 | (code >> 8), code & 0xFF]))\nprint('off %.2f' % volts())\n",
