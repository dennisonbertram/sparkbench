 "example": {
  "code": "from machine import ADC, Pin\nimport time\nadc = ADC(Pin({S}))\ntry:\n    adc.atten(ADC.ATTN_11DB)\nexcept AttributeError:\n    pass\n# 30k/7.5k module divider, loaded by the 10k/20k divider to the ADC pin\nr2 = 7500 * 30000 / (7500 + 30000)\nk = (30000 + r2) / r2 * 30000 / 20000\nwhile True:\n    print('V=%.1f' % (adc.read_u16() * 3.3 / 65535 * k))\n    time.sleep_ms(300)\n",
  "test": {
   "id": "t",
   "title": "reads 12 V",
   "source": "user",
   "steps": [
    {
     "kind": "set",
     "part": "{REF}",
     "control": "value",
     "value": 12
    },
    {
     "kind": "expect",
     "what": "serial",
     "text": "V=12.0",
     "within": 3000
    }
   ]
  }
 }
