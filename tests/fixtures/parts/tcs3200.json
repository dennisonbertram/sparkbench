 "example": {
  "code": "from machine import Pin\nimport time\ns0 = Pin({S0}, Pin.OUT); s1 = Pin({S1}, Pin.OUT); s2 = Pin({S2}, Pin.OUT); s3 = Pin({S3}, Pin.OUT)\nout = Pin({OUT}, Pin.IN)\ns0.value(0); s1.value(1)  # 2% scaling\nn = 0\ndef cb(p):\n    global n\n    n += 1\nout.irq(trigger=Pin.IRQ_RISING, handler=cb)\ndef hz(a, b):\n    global n\n    s2.value(a); s3.value(b)\n    time.sleep_ms(5)\n    n = 0\n    time.sleep_ms(100)\n    return round(n * 10, -2)\nwhile True:\n    print('R=%d G=%d B=%d' % (hz(0, 0), hz(1, 1), hz(0, 1)))\n    time.sleep_ms(200)\n",
