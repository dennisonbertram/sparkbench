 "driver": {
  "filename": "qwiic_relay.py",
  "code": "# Port of SparkFun_Qwiic_Relay_Arduino_Library (quad/dual boards): commands are single bytes; a status read is the\n# status command followed by a 1-byte read (0x0F = on, 0x00 = off).\nclass QwiicRelay:\n    def __init__(self, i2c, addr):\n        self.i2c = i2c\n        self.addr = addr\n\n    def _read(self, cmd):\n        self.i2c.writeto(self.addr, bytes([cmd]))\n        return self.i2c.readfrom(self.addr, 1)[0]\n\n    def state(self, relay):\n        return 1 if self._read(0x04 + relay) == 0x0F else 0\n\n    def toggle(self, relay):\n        self.i2c.writeto(self.addr, bytes([relay]))\n\n    def on(self, relay):\n        if not self.state(relay):\n            self.toggle(relay)\n\n    def off(self, relay):\n        if self.state(relay):\n            self.toggle(relay)\n\n    def all_off(self):\n        self.i2c.writeto(self.addr, bytes([0x0A]))\n\n    def all_on(self):\n        self.i2c.writeto(self.addr, bytes([0x0B]))\n\n    def toggle_all(self):\n        self.i2c.writeto(self.addr, bytes([0x0C]))\n\n    def set_slow_pwm(self, relay, value):\n        self.i2c.writeto(self.addr, bytes([0x0F + relay, value]))\n\n    def get_slow_pwm(self, relay):\n        return self._read(0x0F + relay)\n"
 },
 "example": {
  "code": "from machine import I2C, Pin\nimport time\nfrom qwiic_relay import QwiicRelay\ni2c = I2C({I2C_ID}, sda=Pin({SDA}), scl=Pin({SCL}))\nr = QwiicRelay(i2c, 0x6D)\nr.all_off()\nr.on(1)\nr.on(3)\nr.on(3)  # already on: no change\nprint('R=' + ''.join(str(r.state(n)) for n in (1, 2, 3, 4)))\ni2c.writeto(0x6D, bytes([0x05]))\nprint('S=' + ''.join('%02X' % b for b in i2c.readfrom(0x6D, 4)))\nprint('NEXT=%02X' % i2c.readfrom(0x6D, 1)[0])\ntime.sleep(3)\nr.toggle_all()\nprint('T=' + ''.join(str(r.state(n)) for n in (1, 2, 3, 4)))\nwhile True:\n    time.sleep(1)\n",
