{"type": "custom-gps-test", "name": "GPS test", "mpn": "NEO-6M", "category": "sensor", "description": "t", "eli5": "t", "refPrefix": "U", "interface": "uart", "pins": [{"name": "VCC", "role": "power", "required": true}, {"name": "RX", "role": "io", "fn": "uart.rx", "required": false}, {"name": "TX", "role": "io", "fn": "uart.tx", "required": true}, {"name": "GND", "role": "gnd", "required": true}], "vmin": 3.3, "vmax": 5, "currentMa": 45, "priceUsd": 8, "supplierQuery": "NEO-6M", "sim": {"kind": "uart-device", "uartBaud": 9600, "quantity": "Latitude", "unit": "\u00b0", "min": -90, "max": 90, "default": 51.5, "controls": [{"key": "lat", "quantity": "Latitude", "unit": "\u00b0", "min": -90, "max": 90, "default": 51.5}, {"key": "lon", "quantity": "Longitude", "unit": "\u00b0", "min": -180, "max": 180, "default": -0.12}], "uartStream": {"everyMs": 1000, "nmea": true}}, "example": {"code": "from machine import UART, Pin\nimport time\nu = UART({UART_ID}, baudrate=9600, tx=Pin({RX}), rx=Pin({TX}))\ndef deg(v, h):\n    d = int(float(v) / 100)\n    x = d + (float(v) - d * 100) / 60\n    return -x if h in 'SW' else x\nwhile True:\n    line = u.readline()\n    if line and line.startswith(b'$GPGGA'):\n        f = line.decode().split(',')\n        print('LAT=%.4f LON=%.4f' % (deg(f[2], f[3]), deg(f[4], f[5])))\n    time.sleep_ms(50)\n", "test": {"id": "t", "title": "fix", "source": "user", "steps": [{"kind": "set", "part": "{REF}", "control": "lat", "value": -33.8688}, {"kind": "set", "part": "{REF}", "control": "lon", "value": 151.2093}, {"kind": "expect", "what": "serial", "text": "LAT=-33.8688 LON=151.2093", "within": 4000}]}}}