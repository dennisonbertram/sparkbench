 "example": {
  "code": "from machine import I2C, Pin\nimport time\ni2c = I2C({I2C_ID}, sda=Pin({SDA}), scl=Pin({SCL}))\ni2c.writeto(0x5E, bytes([0x00, 0x05, 0x00, 0x40]))\ndef s12(v):\n    return v - 4096 if v & 0x800 else v\nwhile True:\n    r = i2c.readfrom(0x5E, 7)\n    bx = s12((r[0] << 4) | (r[4] >> 4))\n    by = s12((r[1] << 4) | (r[4] & 0x0F))\n    print('BX=%.1f BY=%.1f F=%d' % (bx * 0.098, by * 0.098, r[5]))\n    time.sleep(1)\n",
