 "example": {
  "code": "from machine import I2C, Pin\nimport time\nADDR = 0x57\ni2c = I2C({I2C_ID}, sda=Pin({SDA}), scl=Pin({SCL}), freq=400000)\ndef w(r, v):\n    i2c.writeto_mem(ADDR, r, bytes([v]))\ndef r8(r):\n    return i2c.readfrom_mem(ADDR, r, 1)[0]\nprint('part %02x' % r8(0xFF))\nw(0x09, 0x40)\nwhile r8(0x09) & 0x40:\n    time.sleep_ms(1)\nw(0x08, 0x10)\nw(0x0A, 0x27)\nw(0x0C, 0x24)\nw(0x0D, 0x24)\nw(0x04, 0)\nw(0x05, 0)\nw(0x06, 0)\nw(0x09, 0x03)\nir = []\nwhile len(ir) < 800:\n    n = (r8(0x04) - r8(0x06)) & 0x1F\n    if n:\n        d = i2c.readfrom_mem(ADDR, 0x07, n * 6)\n        for i in range(n):\n            ir.append(((d[6 * i + 3] << 16) | (d[6 * i + 4] << 8) | d[6 * i + 5]) & 0x3FFFF)\n    time.sleep_ms(50)\nlo = min(ir)\ncut = (sum(ir) / len(ir) + lo) / 2\nbeats = []\nfor i in range(2, len(ir) - 2):\n    if ir[i] < cut and ir[i] == min(ir[i - 2:i + 3]) and (not beats or i - beats[-1] > 20):\n        beats.append(i)\nprint('BPM=%d' % round(60 * 100 * (len(beats) - 1) / (beats[-1] - beats[0])))\n",
