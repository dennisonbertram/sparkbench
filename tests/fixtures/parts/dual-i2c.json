{"type": "custom-dual-test", "name": "Dual-chip test", "mpn": "LSM303AGR", "category": "sensor", "description": "t", "eli5": "t", "refPrefix": "U", "interface": "i2c", "pins": [{"name": "VIN", "role": "power", "required": true}, {"name": "GND", "role": "gnd", "required": true}, {"name": "SCL", "role": "io", "fn": "i2c.scl", "required": true}, {"name": "SDA", "role": "io", "fn": "i2c.sda", "required": true}], "vmin": 3, "vmax": 5.5, "currentMa": 1, "i2cAddress": 25, "priceUsd": 12, "supplierQuery": "LSM303AGR", "sim": {"kind": "i2c-device", "autoIncrementBit7": true, "quantity": "Accel X counts", "min": -32768, "max": 32767, "default": 0, "controls": [{"key": "mag", "quantity": "Mag X counts", "min": -32768, "max": 32767, "default": 0}], "measures": [{"reg": "0x28", "bytes": 2, "scale": 1, "signed": true, "littleEndian": true}], "subDevices": [{"i2cAddress": 30, "measures": [{"reg": "0x68", "bytes": 2, "scale": 1, "signed": true, "littleEndian": true, "control": "mag"}]}]}, "example": {"code": "from machine import I2C, Pin\nimport time\ni2c = I2C({I2C_ID}, sda=Pin({SDA}), scl=Pin({SCL}))\nprint('found', [hex(a) for a in i2c.scan()])\ni2c.writeto_mem(0x19, 0x20, b'\\x57')\ni2c.writeto_mem(0x1E, 0x60, b'\\x00')\nwhile True:\n    a = i2c.readfrom_mem(0x19, 0x28 | 0x80, 2)\n    m = i2c.readfrom_mem(0x1E, 0x68, 2)\n    ax = int.from_bytes(a, 'little')\n    mx = int.from_bytes(m, 'little')\n    print('AX=%d MX=%d' % (ax if ax < 32768 else ax - 65536, mx if mx < 32768 else mx - 65536))\n    time.sleep_ms(300)\n", "test": {"id": "t", "title": "both chips", "source": "user", "steps": [{"kind": "set", "part": "{REF}", "control": "value", "value": -1234}, {"kind": "set", "part": "{REF}", "control": "mag", "value": 567}, {"kind": "expect", "what": "serial", "text": "AX=-1234 MX=567", "within": 3000}]}}}