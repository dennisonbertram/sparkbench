{
  "type": "custom-hc-05",
  "name": "HC-05 Bluetooth serial module",
  "mpn": "HC-05",
  "category": "ic",
  "description": "Classic Bluetooth 2.0+EDR serial-port (SPP) module built on the CSR BC417: a phone or PC pairs with it (PIN 1234) and the bytes appear on its UART. Master or slave, configured with AT commands at 38400 baud while its button is held at power-up. Supply 3.6-6 V through the on-board 3.3 V regulator; RXD/TXD are 3.3 V logic. Sold as: HC-05 ZS-040 breakout (6-pin header: STATE, RXD, TXD, GND, VCC, EN; AT-mode push button and status LED on the board).",
  "eli5": "Lets your phone talk to your board over Bluetooth, like an invisible serial cable.",
  "refPrefix": "U",
  "interface": "uart",
  "pins": [
    {
      "name": "STATE",
      "role": "io",
      "description": "Connection status output (BT module PIO1/pin 32): high while a Bluetooth link is up, low otherwise. 3.3 V logic",
      "required": false
    },
    {
      "name": "RXD",
      "role": "io",
      "fn": "uart.rx",
      "description": "Module's UART input, 3.3 V logic only. Wire to the microcontroller's TX (use a 1k/2k divider from a 5 V board)",
      "required": true
    },
    {
      "name": "TXD",
      "role": "io",
      "fn": "uart.tx",
      "description": "Module's UART output (3.3 V). Wire to the microcontroller's RX",
      "required": true,
      "levelV": 3.3
    },
    {
      "name": "GND",
      "role": "gnd",
      "description": "Ground",
      "required": true
    },
    {
      "name": "VCC",
      "role": "power",
      "description": "Supply 3.6-6 V into the board's 3.3 V regulator (use 5 V, not 3.3 V)",
      "required": true
    },
    {
      "name": "EN",
      "role": "io",
      "description": "EN/KEY: joined to the button that drives the module's pin 34 (KEY) to 3.3 V. High at power-up = full AT command mode at 38400 baud; leave unconnected for normal data mode",
      "required": false
    }
  ],
  "vmin": 3.6,
  "vmax": 6,
  "currentMa": 40,
  "datasheetUrl": "https://components101.com/sites/default/files/component_datasheet/HC-05%20Datasheet.pdf",
  "sources": [
    "https://components101.com/sites/default/files/component_datasheet/HC-05%20Datasheet.pdf",
