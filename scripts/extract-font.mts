// Extract MicroPython's built-in framebuf 8x8 font (as drawn by FrameBuffer.text) into src/sim/fontdata.ts.
import { writeFileSync } from 'node:fs';
import { loadMicroPythonNode } from '../src/sim/node-runner';

let out = '';
const mp = await loadMicroPythonNode({ stdout: (s) => (out += s), stderr: (s) => (out += s) });
mp.runPython(`
import framebuf
rows = []
for code in range(32, 127):
    buf = bytearray(8)
    fb = framebuf.FrameBuffer(buf, 8, 8, framebuf.MONO_VLSB)
    fb.text(chr(code), 0, 0, 1)
    rows.append(','.join(str(b) for b in buf))
print('|'.join(rows))
`);
const glyphs = out.trim().split('|').map((r) => r.split(',').map(Number));
writeFileSync('src/sim/fontdata.ts', `// MicroPython framebuf 8x8 font: for each char 32..126, 8 column bytes (bit 0 = top row). Generated by scripts/extract-font.ts.\nexport const FRAMEBUF_FONT: number[][] = ${JSON.stringify(glyphs)};\n`);
console.log(`${glyphs.length} glyphs`);
