lt" data-element="link" data-pb-style="YW89VPY"><span data-element="link_text">Twitter</span></a></div><div class="tiktok" data-content-type="button-item" data-appearance="default" data-element="main" data-pb-style="B0EXWY8"><a role="button" tabindex="0" class="pagebuilder-button-link" href="https://www.tiktok.com/@sparkfun.electronics?lang=en" target="_blank" data-link-type="default" data-element="link" data-pb-style="PLGADLY"><span data-element="link_text">TikTok</span></a></div></div></div></div></div></div></div><div data-content-type="row" data-appearance="contained" data-element="main"><div class="footer__copyright" data-enable-parallax="0" data-parallax-speed="0.5" data-background-images="{}" data-background-type="image" data-video-loop="true" data-video-play-only-visible="true" data-video-lazy-load="true" data-video-fallback-src="" data-element="inner" data-pb-style="TEGT0SE"><div data-content-type="text" data-appearance="default" data-element="main"><p style="text-align: center;"><strong>SparkFun Electronics &reg;</strong> / 6333 Dry Creek Parkway, Niwot, CO 80503</p></div></div></div></div>
